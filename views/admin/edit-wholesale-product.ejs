<link rel="stylesheet" href="/css/admin-products.css" />

<a href="/admin/wholesale-products" class="wp-back-btn">
  ← Back
</a>

<div class="wp-form-wrapper">

  <div class="wp-form-header">
    <h1>Edit Wholesale Product</h1>
    <p>Update product details</p>
  </div>

  <form 
    action="/admin/wholesale-products/edit/<%= product._id %>" 
    method="POST" 
    enctype="multipart/form-data"
    class="wp-form"
  >

    <!-- NAME -->
    <div class="wp-group">
      <label>Product Name</label>
      <input type="text" name="name" value="<%= product.name %>" required />
    </div>

    <!-- PRICE + STOCK -->
    <div class="wp-row">
      <div class="wp-group">
        <label>Price (£)</label>
        <input type="number" step="0.01" name="price" value="<%= product.price %>" required />
      </div>

      <div class="wp-group">
        <label>Stock</label>
        <input type="number" name="stock" value="<%= product.stock %>" />
      </div>
    </div>

    <!-- BRAND + STRENGTH -->
    <div class="wp-row">
      <div class="wp-group">
        <label>Brand</label>
        <input type="text" name="brand" value="<%= product.brand %>" />
      </div>

      <div class="wp-group">
        <label>Strength</label>
        <select name="strength">
          <option <%= product.strength === "LOW" ? "selected" : "" %>>LOW</option>
          <option <%= product.strength === "MEDIUM" ? "selected" : "" %>>MEDIUM</option>
          <option <%= product.strength === "STRONG" ? "selected" : "" %>>STRONG</option>
          <option <%= product.strength === "X-STRONG" ? "selected" : "" %>>X-STRONG</option>
          <option <%= product.strength === "EXTREME" ? "selected" : "" %>>EXTREME</option>
        </select>
      </div>
    </div>

    <!-- DESCRIPTION -->
    <div class="wp-group">
      <label>Description</label>
      <textarea name="description" rows="4"><%= product.description %></textarea>
    </div>

    <!-- EXISTING IMAGES -->
    <div class="wp-group">
      <label>Existing Images</label>

      <div class="wp-images-grid">
        <% product.images.forEach(img => { %>
          <div class="wp-img-card">
            <img src="<%= img %>" />

            <label class="wp-remove">
              <input type="checkbox" name="removeImages" value="<%= img %>" />
              Remove
            </label>
          </div>
        <% }) %>
      </div>
    </div>

    <!-- NEW IMAGES -->
    <div class="wp-group">
      <label>Upload New Images</label>
      <input type="file" name="images" multiple class="wp-file" />
    </div>

    <!-- SUBMIT -->
    <button type="submit" class="wp-submit-btn">
      <i class="fa-solid fa-save"></i> Update Product
    </button>

  </form>

</div>