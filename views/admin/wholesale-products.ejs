<h1 class="page-title">Wholesale Products</h1>


<div id="deleteModal" class="delete-modal">
  <div class="delete-box">
    <h3>Delete Product</h3>
    <p>Are you sure you want to delete this product?</p>

    <div class="delete-actions">
      <button id="cancelDelete">Cancel</button>

      <form id="deleteForm" method="POST">
        <button type="submit" class="confirm-delete">
          Yes, Delete
        </button>
      </form>
    </div>
  </div>
</div>
<div class="top-bar">
<div class="admin-filters">
  
<select onchange="applyFilter()" id="brandFilter">
  <!-- BRAND -->
  <option value="">All Brands</option>
<option value="WHITE FOX" <%= query.brand === "WHITE FOX" ? "selected" : "" %>>WHITE FOX</option>
<option value="SIBERIA" <%= query.brand === "SIBERIA" ? "selected" : "" %>>SIBERIA</option>
<option value="VELO" <%= query.brand === "VELO" ? "selected" : "" %>>VELO</option>
<option value="KILLA" <%= query.brand === "KILLA" ? "selected" : "" %>>KILLA</option>
<option value="PABLO" <%= query.brand === "PABLO" ? "selected" : "" %>>PABLO</option>
<option value="GARANT" <%= query.brand === "GARANT" ? "selected" : "" %>>GARANT</option>
<option value="ICEBERG CUBA" <%= query.brand === "ICEBERG CUBA" ? "selected" : "" %>>ICEBERG CUBA</option>
<option value="LOOP" <%= query.brand === "LOOP" ? "selected" : "" %>>LOOP</option>
<option value="CAFERO" <%= query.brand === "CAFERO" ? "selected" : "" %>>CAFERO</option>
<option value="HIT" <%= query.brand === "HIT" ? "selected" : "" %>>HIT</option>
<option value="ODEN'S" <%= query.brand === "ODEN'S" ? "selected" : "" %>>ODEN'S</option>

</select>
<select onchange="applyFilter()" id="strengthFilter">
  <!-- STRENGTH -->
  <option value="">All Strength</option>
<option value="LOW" <%= query.strength === "LOW" ? "selected" : "" %>>LOW</option>
<option value="MEDIUM" <%= query.strength === "MEDIUM" ? "selected" : "" %>>MEDIUM</option>
<option value="STRONG" <%= query.strength === "STRONG" ? "selected" : "" %>>STRONG</option>

<option value="X-STRONG" <%= query.strength === "X-STRONG" ? "selected" : "" %>>X-STRONG</option>
<option value="EXTREME" <%= query.strength === "EXTREME" ? "selected" : "" %>>EXTREME</option>

</select>

 <select onchange="applyFilter()" id="sortFilter">
  <!-- SORT -->
 <option value="">Newest</option>
<option value="price-low" <%= query.sort === "price-low" ? "selected" : "" %>>Price Low</option>
<option value="price-high" <%= query.sort === "price-high" ? "selected" : "" %>>Price High</option>
<option value="name" <%= query.sort === "name" ? "selected" : "" %>>Name A-Z</option>
</select>

<select onchange="applyFilter()" id="stockFilter">
  <!-- STOCK -->
  <option value="">All</option>
<option value="in" <%= query.stock === "in" ? "selected" : "" %>>In Stock</option>
<option value="out" <%= query.stock === "out" ? "selected" : "" %>>Out of Stock</option>
</select>
</div>

<a href="/admin/wholesale-products/add" class="admin-add-btn">+ Add Product</a>
</div>

<div class="admin-grid">

  <% products.forEach(p => { %>

    <div class="card">

      <div class="img-box">
        <img src="<%= p.images[0] %>" />

        <span class="stock <%= p.stock > 0 ? 'in' : 'out' %>">
          <%= p.stock > 0 ? 'In Stock' : 'Out Of Stock' %>
        </span>
      </div>

      <div class="card-body">
        <h3><%= p.name %></h3>

        <p class="price">£<%= p.price.toFixed(2) %></p>

        <div class="meta">
          <span><i class="fa-solid fa-tag"></i> <%= p.brand %></span>
          <span><i class="fa-solid fa-bolt"></i> <%= p.strength %></span>
        </div>

        <p class="stock-count">Stock: <%= p.stock %></p>

        <div class="admin-actions">
          <a href="/admin/wholesale-products/edit/<%= p._id %>" class="edit">
            <i class="fa-solid fa-pen"></i>
          </a>

          <button class="delete-btn" data-id="<%= p._id %>">
            <i class="fa-solid fa-trash"></i>
          </button>
        </div>
      </div>

    </div>

  <% }) %>

</div>
<button id="loadMore" class="lmp">
  <span class="text">Load More</span>
  <span class="loader"></span>
</button>


<script>
const modal = document.getElementById("deleteModal");
const deleteForm = document.getElementById("deleteForm");
const cancelBtn = document.getElementById("cancelDelete");

document.querySelectorAll(".delete-btn").forEach(btn => {
  btn.addEventListener("click", () => {
    const id = btn.dataset.id;

    deleteForm.action = "/admin/wholesale-products/delete/" + id;

    modal.classList.add("active");
  });
});


cancelBtn.addEventListener("click", () => {
  modal.classList.remove("active");
});


modal.addEventListener("click", (e) => {
  if (e.target === modal) {
    modal.classList.remove("active");
  }
});
</script>


<script>
function applyFilter() {
  const brand = document.getElementById("brandFilter").value;
  const strength = document.getElementById("strengthFilter").value;
  const sort = document.getElementById("sortFilter").value;
  const stock = document.getElementById("stockFilter").value;

  let params = new URLSearchParams();

  if (brand) params.append("brand", brand);
  if (strength) params.append("strength", strength);
  if (sort) params.append("sort", sort);
  if (stock) params.append("stock", stock);

  window.location.href = "/admin/wholesale-products?" + params.toString();
}
</script>

<script>
let page = 1;

document.getElementById("loadMore").addEventListener("click", async () => {
  page++;

  const urlParams = new URLSearchParams(window.location.search);
  urlParams.set("page", page);

  const res = await fetch(`/admin/wholesale-products?${urlParams.toString()}`, {
    headers: { Accept: "application/json" },
  });

  const data = await res.json();

  const container = document.querySelector(".admin-grid");

  data.products.forEach(p => {
    container.insertAdjacentHTML("beforeend", `
      <div class="card">
        <img src="${p.images?.[0] || ''}" />
        <h3>${p.name}</h3>
        <p>£${p.price}</p>
        <p>Stock: ${p.stock}</p>
      </div>
    `);
  });

  if (!data.hasMore) {
    document.getElementById("loadMore").style.display = "none";
  }
});
</script>

<script>
  const loadBtn = document.getElementById("loadMore");

loadBtn.addEventListener("click", async () => {
  loadBtn.classList.add("loading");

  
  const res = await fetch(/* your url */);
  const data = await res.json();


  loadBtn.classList.remove("loading");

  if (!data.hasMore) {
    loadBtn.disabled = true;
    loadBtn.querySelector(".text").innerText = "No More Products";
  }
});
</script>